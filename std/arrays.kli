import std.optional.Option
import builtins
import std.panicking.panic_message




fun assert_in_bounds[T](this : array[T], index : UInt64) -> () = 
    case index < builtins.array_len(this) of
    | false -> index_out_bounds()
    | true -> ()
    end

fun base_ptr[T](this : array[T]) -> RawPtr[T] = do
    builtins.array_ptr(this)
end

fun ptr_to_element[T](this : array[T], index : UInt64) -> RawPtr[T] = do
    assert_in_bounds(this,index);
    unsafe ptr_to_element_unchecked(this,index) end
end

@unsafe
fun ptr_to_element_unchecked[T](this : array[T], index : UInt64) -> RawPtr[T] = do
    builtins.offset(base_ptr(this),index)
end

@unsafe
fun from_raw_parts[T](p : RawPtr[T], len : UInt64) -> array[T] = do
    builtins.array_new(p,len)
end

fun alloc_copy[T](this : array[T]) -> array[T] = do
    let len = builtins.array_len(this);
    let p = builtins.gc_alloc(len);
    unsafe 
        builtins.ptr_copy(p,builtins.array_ptr(this),len);
        builtins.array_new(p,len) 
    end

end

fun index_out_bounds() -> never = panic_message("index out of bounds")

fun empty[T]() -> array[T] = []

fun len[T](this : array[T]) -> UInt64 = builtins.array_len(this)

fun addr_eq[T](this : array[T], other : array[T]) -> bool = builtins.array_ptr(this) == builtins.array_ptr(other)

fun repeat[T](count : UInt64, value : T) -> array[T] = do
    let ptr = builtins.gc_alloc[T](count);
    for i in 0..count do
        let p = builtins.offset(ptr,i);
        unsafe 
            builtins.ptr_write(p,value)
        end;
    end;
    unsafe from_raw_parts(ptr,count) end
end

fun get_checked[T](this : array[T], index : UInt64) -> Option[T] = 
    case index < len(this) of 
    | true -> Option.Some(this.[index])
    | false -> Option.None[T]
    end

fun get[T](this : array[T], index : UInt64) -> T = 
    this.[index]


fun set[T](this : array[T], index : UInt64, value : T) -> () = 
    this.[index] = value


fun copy_from[T](this : array[T], other : array[T]) -> () = 
    case addr_eq(this,other) of
    | true -> ()
    | false -> 
        do
            let min_len = std.num.uint.min(builtins.array_len(this),builtins.array_len(other));
            for i in 0..min_len do
                this.[i] = other.[i];
            end
        end
    end

fun reverse[T](this : array[T]) -> () = do
    let len = builtins.array_len(this);
    case len of 
    | 0 -> return ()
    | 1 -> return ()
    | _ -> ()
    end;
    for i in 0..len/2 do
        let back_index = len - i - 1;
        let tmp = this.[i];
        this.[i] = this.[back_index];
        this.[back_index] = tmp;
    end;

end

fun for_each[T](elements : array[T], f : fun(UInt64,T) -> ()) -> () =
    for i in 0..len(elements) do 
        f(i,elements.[i])
    end
    

fun for_each_with_ctxt[C,T](ctxt : C, elements : array[T], f : fun(C, UInt64,T) -> C) -> C = 
    do
        for i in 0..len(elements) do 
            ctxt = f(ctxt,i,elements.[i])
        end;
        ctxt
    end


# Safety: 
#  all zeroes must be a valid bit pattern for T
@unsafe
fun zero_slot[T](this : array[T], index : UInt64) -> () = do
    assert_in_bounds(this,index);
    unsafe
        zero_slot_unchecked(this,index);
    end

end

# Safety: 
# `index` must be in bounds for `this`
#  all zeroes must be a valid bit pattern for T
@unsafe
fun zero_slot_unchecked[T](this : array[T], index : UInt64) -> () = do 
    let ptr = ptr_to_element_unchecked(this,index);
    builtins.write_zeroes(ptr);
end

# Copies all elements in the range `src_start` .. `src_start` + `count` of `src`
# to range `dst_start` .. `dst_start` + `count` of `dst`
# Panics:
#  if any index in the destination range is out of bounds for `dst`
#  if any index in the source range is out of bounds for `src`
fun copy[T](dst : array[T], src : array[T], dst_start : UInt64, src_start : UInt64, count : UInt64) -> () = do
    let dst_len = builtins.array_len(dst);
    let src_len = builtins.array_len(src);
    case (dst_start + count) > dst_len or (src_start + count) > src_len of
    | true -> index_out_bounds()
    | false -> ()
    end;
    unsafe 
        copy_unchecked(dst,src,dst_start,src_start,count)
    end
end

# Copies all elements in the range `src_start` .. `src_start` + `count` of `src`
# to range `dst_start` .. `dst_start` + `count` of `dst`
# Safety:
#  all indices in the destination range are in bounds for `dst`
#  all indices in the source range are in bounds for `src` 
@unsafe
fun copy_unchecked[T](dst : array[T], src : array[T], dst_start : UInt64, src_start : UInt64, count : UInt64) -> () = do
    let dst_base = builtins.offset(builtins.array_ptr(dst),dst_start);
    let src_base = builtins.offset(builtins.array_ptr(src),src_start);
    builtins.ptr_copy(dst_base,src_base,count);
end