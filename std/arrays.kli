import std.optional.Option
import builtins
import std.panicking.panic_message

fun index_out_bounds() -> never = panic_message("index out of bounds")

fun empty[T]() -> array[T] = []

fun len[T](this : array[T]) -> uint = builtins.array_len(this)

fun addr_eq[T](this : array[T], other : array[T]) -> bool = builtins.array_addr(this) == builtins.array_addr(other)

fun repeat[T](count : uint, value : T) -> array[T] = builtins.array_repeat(value,count)

fun get_checked[T](this : array[T], index : uint) -> Option[T] = 
    case index < len(this) of 
    | true -> Option.Some((this).[index])
    | false -> Option.None
    end

fun get[T](this : array[T], index : uint) -> T = 
    (this).[index]


fun set[T](this : array[T], index : uint, value : T) -> () = 
    (this).[index] = value


fun copy_from[T](this : array[T], other : array[T]) -> () = 
    case addr_eq(this,other) of
    | true -> ()
    | false -> 
        do
            let min_len = std.ints.umin(builtins.array_len(this),builtins.array_len(other));
            for i in 0u..min_len do
                (this).[i] = (other).[i];
            end
        end
    end

fun reverse[T](this : array[T]) -> () = do
    let mut i = 0u;
    let len = builtins.array_len(this);
    case len of 
    | 0 -> return ()
    | 1 -> return ()
    | _ -> ()
    end;
    for i in 0u..(len/2u) do
        let tmp = (this).[i];
        (this).[i] = (this).[(len - i) - 1u];
        (this).[(len - i) - 1u] = tmp;
    end;

end