import std.arrays
import std.optional.(Option,expect_value)
import std.boxed
import std.num.(uint,int)
import std.panicking
import std.fmt as fmt_

@opaque
type DynArrayInner[T] = {
    ptr : RawPtr[T],
    cap : UInt64,
    len : UInt64
}
@opaque
type DynArray[T] = {
    inner : Box[DynArrayInner[T]]
}
fun new[T]() -> DynArray[T] = with_capacity(0)

fun from_array[T](arr : array[T]) -> DynArray[T] = do
    let len = builtins.array_len(arr);
    let dyn_arr : DynArray[T] = with_capacity(len);
    for i in 0..len do 
        push(dyn_arr,builtins.array_get_unchecked(arr,i))
    end;
    dyn_arr

end

fun with_capacity[T](cap : UInt64) -> DynArray[T] = DynArray {
    inner = boxed.alloc(
        DynArrayInner{
            ptr = builtins.gc_alloc[T](cap),
            cap = cap,
            len = 0
        })
    }

fun ensure_capacity[T](arr : DynArray[T], target_cap : UInt64) -> () = do
    let {ptr = old_buf,cap = current_cap, len = len} = arr.inner^;
    case target_cap < current_cap of 
    | true -> ()
    | false ->
        do
            let new_cap = uint.max(target_cap,current_cap * 2);
            let new_buf = builtins.gc_alloc[T](new_cap);
            builtins.ptr_co
            arr.inner^.buf = new_buf;
        end
    end
end

fun reserve[T](arr : DynArray[T], extra : UInt64) -> () = do
    case extra of 
    | 0 -> ()
    | n -> ensure_capacity(arr,arr.inner^.len + extra)
    end
end

fun clear[T](this : DynArray[T]) -> () = do
    let len = this.inner^.len;
    this.inner^.len = 0;
    for i in 0 .. len do
        unsafe 
            arrays.zero_slot_unchecked[T](this.inner^.buf,i)
        end
    end
end

fun set[T](arr : DynArray[T], index : UInt64, element : T) -> () = do
    case index < arr.inner^.len of
    | false -> arrays.index_out_bounds()
    | true -> 
        unsafe 
            builtins.array_set_unchecked(arr.inner^.buf,index,builtins.uninit_new(element))
        end
    end
end

fun get[T](arr : DynArray[T], index : UInt64) -> T = do
    case index < arr.inner^.len of
    | false -> arrays.index_out_bounds()
    | true -> 
        unsafe 
            builtins.transmute(builtins.array_get_unchecked(arr.inner^.buf,index))
        end
    end
end

fun push[T](arr : DynArray[T], element : T) -> () = do
    reserve(arr,1);
    unsafe 
        builtins.array_set_unchecked(arr.inner^.buf,arr.inner^.len,builtins.transmute(element));
    end;
    arr.inner^.len = arr.inner^.len + 1;
end

fun pop[T](this : DynArray[T]) -> Option[T] = do
    case this.inner^.len of
    | 0 -> Option.None
    | old_len ->
        do
            let new_len = builtins.wrapping_sub(old_len,1);
            let value = unsafe builtins.uninit_assume_init(builtins.array_get_unchecked(this.inner^.buf,new_len)) end;
            unsafe arrays.zero_slot_unchecked(this.inner^.buf,new_len) end;
            this.inner^.len = new_len;
            Option.Some(value)
        end
    end
end

fun insert[T](arr : DynArray[T], index : UInt64, value : T) -> () = do
    let old_len = arr.inner^.len;
    case index > old_len  of
    | true -> arrays.index_out_bounds()
    | false -> ()
    end;
    let new_len = old_len + 1;
    reserve(arr,1);

    let elems_to_move = uint.wrapping_sub(old_len,index);
    unsafe arrays.copy_unchecked(arr.inner^.buf,arr.inner^.buf,index + 1, index, elems_to_move) end;
    unsafe builtins.array_set_unchecked(arr.inner^.buf,index,builtins.transmute(value)) end;
    arr.inner^.len = new_len;
end


fun remove[T](arr : DynArray[T], index : UInt64) -> T = do
    let old_len = arr.inner^.len;
    case index > old_len  of
    | true -> arrays.index_out_bounds()
    | false -> ()
    end;
    let value : T = unsafe 
        builtins.transmute(builtins.array_get_unchecked(arr.inner^.buf,index)) 
    end;
    unsafe 
        arrays.zero_slot_unchecked((arr.inner^.buf),index);
    end;
    let new_len = arr.inner^.len - 1;
    let elems_to_move = uint.wrapping_sub(old_len,index);
    unsafe arrays.copy_unchecked(arr.inner^.buf,arr.inner^.buf,index, index + 1, elems_to_move) end;
    arr.inner^.len = new_len;
    value
end

fun remove_last[T](arr : DynArray[T]) -> T = 
    case pop(arr) of 
    | .Some(value) -> value 
    | .None -> panicking.panic_message("cannot remove from empty list")
    end

fun append_array[T](this : DynArray[T], arr : array[T]) -> () = do
    let len = builtins.array_len(arr);
    reserve(this,len);
    for i in 0..len do
        let value = unsafe builtins.array_get_unchecked(arr,i) end;
        push(this,value);
    end
end

fun len[T](arr : DynArray[T]) -> UInt64 = arr.inner^.len

fun capacity[T](arr : DynArray[T]) -> UInt64 = builtins.array_len(arr.inner^.buf)

fun into_array[T](arr : DynArray[T]) -> array[T] = do
    case arr.inner^.len of
    | 0 -> []
    | len -> do
        let buf = builtins.raw_array_alloc[T](len);
        unsafe arrays.copy_unchecked(buf,arr.inner^.buf,0,0,len) end;
        unsafe builtins.transmute(buf) end
        end
    end
end

fun shrink_to_fit[T](this : DynArray[T]) -> () = do
    let len = this.inner^.len;
    case capacity(this) == len of
    | true -> return ()
    | false -> ()
    end;
    let old_buf = this.inner^.buf;
    let new_buf = builtins.raw_array_alloc[T](len);
    unsafe 
        arrays.copy_unchecked(new_buf,old_buf,0,0,len)
    end;
    this.inner^.buf = new_buf;
end

fun drain_to_array[T](this : DynArray[T]) -> array[T] = do
    shrink_to_fit(this);
    let arr : array[T] = unsafe builtins.transmute(this.inner^.buf) end;
    this.inner^.buf = [];
    this.inner^.len = 0;
    arr
end


fun fmt[T,S,C](this : DynArray[T], format_elem : fmt_.Format[T,S,C], writer: fmt_.Writer[S]) -> () = do
    fmt_.write_string(writer,"[");
    for i in 0..len(this) do 
        case i > 0 of
        | true -> fmt_.write_string(writer,",")
        | false -> ()
        end;
        fmt_.write_format(writer,format_elem,dynarray.get(this,i));
    end;
    fmt_.write_string(writer,"]");
end

fun make_fmt[T,S,C](f : fmt_.Format[T,S,C]) -> fmt_.Format[DynArray[T],S,fmt_.Format[T,S,C]] = do
    fmt_.Format {
        ctxt = f,
        fmt = fmt
    }
end
