import std.optional.Option
import std.panicking.panic_message
import std.num.int as ints

fun wrapping_add(x : uint, y : uint) -> uint = builtins.wrapping_add(x,y)

fun overflowing_add(x : uint, y : uint) -> (uint,bool) = builtins.overflowing_add(x,y)

fun wrapping_sub(x : uint, y : uint) -> uint = builtins.wrapping_sub(x,y)

fun overflowing_sub(x : uint, y : uint) -> (uint,bool) = builtins.overflowing_sub(x,y)

fun checked_add(x : uint, y : uint) -> Option[uint] = do 
    case builtins.overflowing_add(x,y) of 
    | (_,false) -> Option.None
    | (res,true) -> Option.Some(res)
    end
end

# Computes the remainder of dividing `value` by `div`
# Panics if div is 0
fun rem(value : uint, div : uint) -> uint = do
    let multiple = value / div;
    value - multiple * div
end


# Performs a bitcast between uint and int
fun bitcast_int(x : uint) -> int = 
    #Safety : int always has same layout as uint
    unsafe builtins.transmute(x) end

# If x is negative panics otherwise performs a bitcast
fun strict_cast_int(x : uint) -> int = 
    case x > ints.bitcast_uint(ints.max_value()) of
    | true -> panic_message("unsigned int too large for signed int")
    | false -> bitcast_int_to_uint(x)
    end


fun max_value() -> uint = builtins.int_max_value()

fun min(x : uint, y : uint) -> int = case x < y of | true -> x | false -> y end

fun max(x : uint, y : uint) -> int = case x > y of | true -> x | false -> y end


fun is_zero(x : uint) -> bool = 
    x == 0

fun is_positive(x : uint) -> bool = 
    x > 0

fun contains_exclusive(x : uint, start : uint , end_ : uint) -> bool = x > start and x < end_

fun as_bool(x : uint) -> Option[bool] = 
    case x of 
    | 0 -> Option.Some(false)
    | 1 -> Option.Some(true)
    | _ -> Option.None
    end

fun extend_byte(x : byte) -> uint = builtins.zero_extend(x)

fun log(value : uint, power : uint) -> uint = 
    case value of 
    | 0 -> panic_message("cannot take log of 0")
    | n -> 
        do
            let mut pow : uint = 0u;
            while value > 0u do 
                value = 
                    value / power;
                pow = pow + 1u;
            end;
            pow
        end
    end