import std.(
    dynarray,
    optional.Option,
    boxed,
    panicking,
    num,
    unicode.iter.(CharIter,CharIterIndices)
    )
@opaque
@lang_item("string")
type String = {}

fun utf8_len(this : string) -> UInt64 = builtins.string_len(this)

@unsafe
fun as_bytes(this : string) -> array[UInt8] = 
    builtins.array_new(
        builtins.string_ptr(this),
        builtins.string_len(this)
    )

@unsafe
fun from_utf8_unchecked(this : array[UInt8]) -> string = builtins.string_new(
    builtins.array_ptr(this),
    builtins.array_len(this)
)

fun equals(first : string, second : string) -> bool = do
    let first_len = utf8_len(first);
    let second_len = utf8_len(second);
    case first_len == second_len of | true -> () | false -> return false end;

    for i in 0..first_len do
        let first_bytes = unsafe as_bytes(first) end;
        let second_bytes = unsafe as_bytes(second) end;
        case first_bytes.[i] == second_bytes.[i] of 
        | false -> return false
        | true -> ()
        end;

    end;
    true

end

fun empty() -> string = ""

fun clone(s : string) -> string = do
    unsafe 
        from_utf8_unchecked(
            arrays.alloc_copy(
                as_bytes(s)
            )
        )
    end
end

fun char_to_uint32(c : char) -> UInt32 = 
    builtins.bitcast(c)

fun uint8_to_char(value : UInt8) -> char = 
    builtins.widen(value)
