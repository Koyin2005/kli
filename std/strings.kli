import std.(
    dynarray,
    optional.Option,
    boxed,
    panicking
    )
@opaque
@lang_item("string")
type String = {}

@unsafe
fun as_bytes(this : string) -> array[UInt8] = builtins.transmute(this)


fun empty() -> string = ""

fun clone(s : string) -> string = do
    let bytes = unsafe as_bytes(s) end;
    let byte_len = builtins.array_len(bytes);
    let mut bs = builtins.raw_array_alloc[UInt8](byte_len);
    for i in 0u..byte_len do
        (bs).[i] = builtins.uninit_new(bytes.[i]);
    end;
    unsafe builtins.transmute(bs) end
end

fun chars(s : string) -> CharIter = CharIter {
    string_bytes = unsafe as_bytes(s) end,
    index = boxed.alloc(0)
}

fun utf8_len(c : char) -> UInt = 
    case c < '\u00FF' of
    | true -> 1
    | _ -> 
        case c < '\u07FF' of 
        | true -> 2
        | _ -> 
            case c < '\uFFFF' of 
            | true -> 3
            | _ -> 4
            end
        end
    end

fun char_to_uint(c : char) -> UInt = 
    # This is the definitions of hack
    builtins.zero_extend(c)

@opaque
type CharIter =  {    
    string_bytes : array[UInt8],
    index : Box[UInt]
}

fun next(iter : CharIter) -> Option[char] = do
    let current = iter.index^;
    case next_char(current,iter.string_bytes) of
    | .None -> Option.None
    | .Some((next_index,next)) -> 
        do
            iter.index^ = next_index;
            Option.Some(next)
        end
    end

end


fun next_char(current_index : UInt, bytes : array[UInt8]) -> Option[(UInt,char)] = do
    let first_byte = case current_index < builtins.array_len(bytes) of 
    | false -> return Option.None
    | true -> bytes.[current_index]
    end;
    current_index = current_index + 1;
    case first_byte < (128:UInt8) of 
    | true -> return Option.Some((current_index,builtins.zero_extend(first_byte)))
    | false -> ()
    end;
    Option.None
end