import std.(
    dynarray,
    optional.Option,
    boxed,
    panicking,
    num,
    unicode.iter.(CharIter,CharIterIndices)
    )
@opaque
@lang_item("string")
type String = {}

@unsafe
fun as_bytes(this : string) -> array[UInt8] = builtins.transmute(this)

@unsafe
fun from_utf8_unchecked(this : array[UInt8]) -> string = builtins.transmute(this)


fun empty() -> string = ""

fun clone(s : string) -> string = do
    unsafe 
        from_utf8_unchecked(
            arrays.alloc_copy(
                as_bytes(s)
            )
        )
    end
end

fun char_to_uint32(c : char) -> UInt32 = 
    builtins.bitcast(c)

fun uint8_to_char(value : UInt8) -> char = 
    builtins.widen(value)
