import std.optional.Option
import std.panicking.panic_message

fun wrapping_add(x : int, y : int) -> int = builtins.wrapping_add(x,y)

fun overflowing_add(x : int, y : int) -> (int,bool) = builtins.overflowing_add(x,y)

fun wrapping_sub(x : int, y : int) -> int = builtins.wrapping_sub(x,y)

fun overflowing_sub(x : int, y : int) -> (int,bool) = builtins.overflowing_sub(x,y)


fun wrapping_uadd(x : uint, y : uint) -> uint = builtins.wrapping_add(x,y)

fun overflowing_uadd(x : uint, y : uint) -> (uint,bool) = builtins.overflowing_add(x,y)

fun wrapping_usub(x : uint, y : uint) -> uint = builtins.wrapping_sub(x,y)

fun overflowing_usub(x : uint, y : uint) -> (uint,bool) = builtins.overflowing_sub(x,y)

fun checked_add(x : int, y : int) -> Option[int] = do 
    case builtins.overflowing_add(x,y) of 
    | (_,false) -> Option.None
    | (res,true) -> Option.Some(res)
    end
end

fun neg(value : int) -> int = builtins.wrapping_sub(0,value)

# Computes the remainder of dividing `value` by `div`
# Panics if div is 0
fun rem(value : int, div : int) -> int = do
    let multiple = value / div;
    value - multiple * div
end

fun log(value : uint, power : uint) -> uint = 
    case value of 
    | 0 -> invalid_value()
    | n -> 
        do
            let mut pow : uint = 0u;
            while value > 0u do 
                value = 
                    value / power;
                pow = pow + 1u;
            end;
            pow
        end
    end

#Performs a bitcast between int and uint
fun bitcast_int_to_uint(x : int) -> uint = 
    #Safety : int always has same layout as uint
    unsafe builtins.transmute(x) end

#Performs a bitcast between uint and int
fun bitcast_uint_to_int(x : uint) -> int = 
    #Safety : uint always has same layout as int
    unsafe builtins.transmute(x) end

fun invalid_value() -> never = panic_message("invalid value")

#If x is negative panics otherwise performs a bitcast
fun strict_cast_int_to_uint(x : int) -> uint = 
    case x < 0 of
    | true -> invalid_value()
    | false -> bitcast_int_to_uint(x)
    end

#If x is greater than the max signed integer panics 
#otherwise performs a bitcast
fun strict_cast_uint_to_int(x : uint) -> int = 
    case x > bitcast_int_to_uint(int_max_value())  of
    | true -> invalid_value()
    | false -> bitcast_uint_to_int(x)
    end

fun int_max_value() -> int = builtins.int_max_value()

fun min(x : int, y : int) -> int = case x < y of | true -> x | false -> y end

fun max(x : int, y : int) -> int = case x > y of | true -> x | false -> y end


fun umin(x : uint, y : uint) -> uint = case x < y of | true -> x | false -> y end

fun umax(x : uint, y : uint) -> uint = case x > y of | true -> x | false -> y end

fun is_zero(x : int) -> bool = 
    x == 0

fun is_negative(x : int) -> bool = 
    x < 0

fun is_positive(x : int) -> bool = 
    x > 0

fun contains_exclusive(x : int, start : int , end_ : int) -> bool = x > start and x < end_

fun as_bool(x : int) -> Option[bool] = 
    case x of 
    | 0 -> Option.Some(false)
    | 1 -> Option.Some(true)
    | _ -> Option.None
    end


fun extend_byte_to_uint(x : byte) -> uint = builtins.zero_extend(x)
fun extend_byte_to_int(x : byte) -> int = builtins.zero_extend(x)