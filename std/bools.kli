fun not(x : bool) -> bool = 
    case x of 
    | true -> false 
    | false -> true 
    end

fun as_int(x : bool) -> Int64 = 
    case x of 
    | true -> 1
    | false -> 0
    end


fun as_uint(x : bool) -> UInt64 = 
    case x of 
    | true -> 1
    | false -> 0
    end

fun as_uint8(x : bool) -> UInt8 = 
    case x of
    | true -> 1
    | false -> 0
    end

fun as_string(x : bool) -> string = case x of | true -> "true" | false -> "false" end