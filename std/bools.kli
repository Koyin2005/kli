fun not(x : bool) -> bool = 
    case x of 
    | true -> false 
    | false -> true 
    end

fun as_int(x : bool) -> Int = 
    case x of 
    | true -> 1
    | false -> 0
    end


fun as_uint(x : bool) -> UInt = 
    case x of 
    | true -> 1
    | false -> 0
    end

fun as_byte(x : bool) -> byte = 
    unsafe builtins.transmute(x) end

fun as_string(x : bool) -> string = case x of | true -> "true" | false -> "false" end