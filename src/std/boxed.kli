import std.refs
import builtins.(
    allocate,
    ptr_write,
    ptr_read,
    deallocate,
    drop_in_place
)

@opaque
@lang_item("box")
type Box[T] = { }
impl 

    fun alloc(value : T) -> Box[T] = panic

    fun get(value : Box[T]) -> T = panic

    fun set(this : Box[T], value : T) -> () = panic


end