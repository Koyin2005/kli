@builtin
fun box_alloc[T](value : T) -> Box[T];

@builtin
@unsafe
fun transmute[T,U](x : T) -> U;

# T must be either an array[U] or raw_array[U]
@builtin
fun array_len[T](a : T) -> uint;

# T must be either an array[U] or raw_array[U]
@builtin
fun array_addr[T](a : T) -> uint;

@builtin
fun wrapping_add[T](x : T, y : T) -> T;

@builtin
fun overflowing_add[T](x : T, y : T) -> (T, bool);

@builtin
fun wrapping_sub[T](x : T, y : T) -> T;

@builtin
fun overflowing_sub[T](x : T, y : T) -> (T, bool);

@builtin
fun zero_extend[T,U](x : T) -> U;

@builtin
fun array_repeat[T](value : T, count : uint) -> array[T];

@builtin
fun raw_array_alloc[T](size : uint) -> raw_array[T];

@builtin
fun array_set_unchecked[T,U](a : T, index : uint, value : U) -> ();

@unsafe
@builtin
fun array_get_unchecked[T,U](a : T, index : uint) -> U;

@builtin
fun print_string(s : string) -> ();

@builtin
fun int_max_value[T]() -> T;

@unsafe
@builtin
fun raw_array_set_zero[T](a : raw_array[T], index : uint) -> ();