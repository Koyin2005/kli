@unsafe
@builtin
fun ptr_copy[T](dst : RawPtr[T], src : RawPtr[T], count : Int) -> ();

@builtin
fun offset[T](p : RawPtr[T], offset : Int) -> RawPtr[T];

# Safety
# p must be aligned, non-null and not dangling
@builtin
@unsafe
fun ptr_write[T](p : RawPtr[T], value : T) -> ();


# Safety
# p must be aligned, non-null and not dangling
# p must point to an intialised valid value of T
@builtin
@unsafe
fun ptr_read[T](p : RawPtr[T]) -> T;

# Safety
# p must be aligned, non-null and not dangling
# A bit pattern of all 0's must produce a valid value of T
@builtin
@unsafe
fun write_zeroes[T](p : RawPtr[T]) -> ();

@builtin
fun array_len[T](a : array[T]) -> Int;

@builtin
fun array_ptr[T](a : array[T]) -> RawPtr[T];

@builtin
fun wrapping_add[T](x : T, y : T) -> T;

@builtin
fun overflowing_add[T](x : T, y : T) -> (T, bool);

@builtin
fun wrapping_sub[T](x : T, y : T) -> T;

@builtin
fun overflowing_sub[T](x : T, y : T) -> (T, bool);

@builtin
fun wrapping_mul[T](x : T, y : T) -> T;

@builtin
fun overflowing_mul[T](x : T, y : T) -> (T, bool);

@builtin
fun string_len(s : string) -> Int;


@builtin
fun print_string(s : string) -> ();

@builtin
fun eprint_string(s : string) -> ();

@builtin
fun int_max_value[T]() -> T;

@builtin
fun read_line() -> string;

@builtin
fun shift_left[T](x : T, y : T) -> T;

@builtin
fun shift_right[T](x : T, y : T) -> T;