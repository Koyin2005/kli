@builtin
fun gc_alloc[T](cap : UInt64) -> RawPtr[T];

@builtin
fun ptr_copy[T](dst : RawPtr[T], src : RawPtr[T], count : UInt64) -> ();

@builtin
fun box_alloc[T](value : T) -> Box[T];

@builtin
fun offset[T](p : RawPtr[T], offset : UInt64) -> RawPtr[T];


@builtin
fun array_len[T](a : array[T]) -> UInt64;

@builtin
fun array_addr[T](a : array[T]) -> UInt64;

@builtin
fun wrapping_add[T](x : T, y : T) -> T;

@builtin
fun overflowing_add[T](x : T, y : T) -> (T, bool);

@builtin
fun wrapping_sub[T](x : T, y : T) -> T;

@builtin
fun overflowing_sub[T](x : T, y : T) -> (T, bool);

@builtin
fun wrapping_mul[T](x : T, y : T) -> T;

@builtin
fun overflowing_mul[T](x : T, y : T) -> (T, bool);

@builtin
fun widen[T,U](x : T) -> U;

@builtin
fun truncate[T,U](x : T) -> U;

@builtin
fun raw_array_alloc[T](size : UInt64) -> array[uninit[T]];


@builtin
fun print_string(s : string) -> ();

@builtin
fun eprint_string(s : string) -> ();

@builtin
fun int_max_value[T]() -> T;

@builtin
fun uninit_zeroed[T]() -> uninit[T];

@builtin
fun read_line() -> string;

@builtin
fun shift_left[T](x : T, y : T) -> T;

@builtin
fun shift_right[T](x : T, y : T) -> T;